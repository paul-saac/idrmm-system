# Supabase project URL (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (Project Settings > API > Publishable key)
# Safe to expose in the browser — do NOT put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase secret key (Project Settings > API Keys > secret keys).
# Older projects call this the "service_role" key instead (starts with
# "eyJ..." rather than "sb_secret_..." — either works the same way).
#
# SERVER-ONLY — no NEXT_PUBLIC_ prefix. Never expose this to the browser.
# It bypasses Row Level Security and is required for account creation
# (Super Admin creating Admins, Admin creating Project Managers/Foremen).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
